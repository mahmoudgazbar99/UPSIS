Options -Indexes
DirectoryIndex accueil.php index.php

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Course library PDFs may weigh up to 25 Mo each.
<IfModule php_module>
    php_value upload_max_filesize 25M
    php_value post_max_size 128M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the logo endpoint in-place (no external 308). Browsers often paint a
    # broken <img> when the src (.php) is redirected before the bytes arrive.
    RewriteRule ^brand_logo\.php$ index.php [L,QSA]

    # Use extensionless canonical URLs for PHP pages.
    # Build Location from the public Host header so reverse proxies (Render)
    # do not leak the internal listen port (:10000) into redirects.
    RewriteCond %{THE_REQUEST} "\s+(/[^?\s]+)\.php(?:[?\s])" [NC]
    RewriteCond %{REQUEST_URI} !^/brand_logo\.php$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} =on
    RewriteRule ^ https://%{HTTP_HOST}%1 [R=308,L,QSA,NE]

    RewriteCond %{THE_REQUEST} "\s+(/[^?\s]+)\.php(?:[?\s])" [NC]
    RewriteCond %{REQUEST_URI} !^/brand_logo\.php$ [NC]
    RewriteRule ^ http://%{HTTP_HOST}%1 [R=308,L,QSA,NE]

    # Keep real public files (accueil, assets, images, exports).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # The public landing page remains a physical file.
    RewriteRule ^accueil$ accueil.php [L]

    # Extensionless ERP URLs are dispatched by public/index.php.
    RewriteRule ^([A-Za-z0-9_-]+)$ index.php [L,QSA]
</IfModule>
