# University AI Assistant (server-side only — never expose to the browser)
# OpenAI-compatible providers: OpenAI, Google AI Studio (Gemini), Neon AI Gateway, etc.
# Cursor keys (crsr_…) are for Cloud Agents / SDK — not chat-completions.
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4o-mini

# Google AI Studio / Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# CHATBOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHATBOT_MODEL=gemini-3.6-flash

# Optional Neon AI Gateway (OpenAI-compatible). If set, CHATBOT_API_KEY may be omitted.
# NEON_AI_GATEWAY_API_KEY=
# NEON_AI_GATEWAY_BASE_URL=

# Cursor Cloud Agents / SDK (optional; not used by the PHP chat completions client)
# CURSOR_API_KEY=
